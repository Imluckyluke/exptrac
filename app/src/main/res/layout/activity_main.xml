<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="locale"
    android:background="?attr/colorSurface"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingEnd="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingBottom="@dimen/content_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:minHeight="@dimen/toolbar_min_height"
        android:paddingBottom="@dimen/content_gap_small">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/app_name" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLanguage"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/toolbar_icon_button_size"
            android:layout_height="@dimen/toolbar_icon_button_size"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="@dimen/toolbar_icon_button_size"
            app:icon="@drawable/ic_language"
            android:contentDescription="@string/cd_language" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStats"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/toolbar_icon_button_size"
            android:layout_height="@dimen/toolbar_icon_button_size"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="@dimen/toolbar_icon_button_size"
            app:icon="@drawable/ic_chart"
            android:contentDescription="@string/cd_stats" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackup"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/toolbar_icon_button_size"
            android:layout_height="@dimen/toolbar_icon_button_size"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="@dimen/toolbar_icon_button_size"
            app:icon="@drawable/ic_backup"
            android:contentDescription="@string/cd_backup" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSmsSettings"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/toolbar_icon_button_size"
            android:layout_height="@dimen/toolbar_icon_button_size"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="@dimen/toolbar_icon_button_size"
            app:icon="@drawable/ic_sms"
            android:contentDescription="@string/cd_sms_settings" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="@dimen/corner_card_header"
        app:cardElevation="@dimen/elevation_header_resting"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="@dimen/content_gap_small"
            android:paddingBottom="@dimen/content_gap_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrev"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_chevron_left"
                    android:contentDescription="@string/cd_previous_day" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:textDirection="locale"
                            android:textStyle="bold"
                            android:text="@string/date_placeholder" />

                        <TextView
                            android:id="@+id/todayBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_today_badge"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/today_badge_text"
                            android:text="@string/today_badge"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/content_gap_small"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:textDirection="locale"
                        android:textColor="?attr/colorPrimary"
                        tools:ignore="HardcodedText"
                        tools:text="Total today: 0 Toman" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_chevron_right"
                    android:contentDescription="@string/cd_next_day" />

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/dayContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/content_gap">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExpenses"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:alpha="0"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_empty_receipt"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/content_gap"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:textDirection="locale"
                android:textColor="?attr/colorOnSurface"
                android:text="@string/empty_state_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/content_gap_small"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:textDirection="locale"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:text="@string/empty_state_subtitle" />

        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox" app:boxBackgroundColor="?attr/colorSurfaceContainerLowest"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.RoundedField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_gap_small"
        android:hint="@string/hint_description">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textDirection="locale"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox" app:boxBackgroundColor="?attr/colorSurfaceContainerLowest"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.RoundedField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_gap_small"
        android:hint="@string/hint_amount">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textDirection="ltr"
            android:fontFamily="sans-serif"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:digits="0123456789۰۱۲۳۴۵۶۷۸۹٠١٢٣٤٥٦٧٨٩"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_gap_small"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:singleLine="true" />
    </HorizontalScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdd"
        style="@style/Widget.Material3.Button"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Pill"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart"
        app:backgroundTint="?attr/colorPrimary"
        app:elevation="4dp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/content_gap"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:textStyle="bold"
        android:text="@string/btn_add" />

</LinearLayout>
